{
  "name": "md-toolbox",
  "productName": "MD工具箱",
  "version": "1.0.0",
  "description": "轻量、高性能的 Markdown 编辑与预览工具箱（Electron + React + CodeMirror 6 + unified）",
  "main": "./out/main/index.js",
  "author": "jiuji",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint --ext .ts,.tsx src tests",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sandbox": "node --experimental-strip-types --no-warnings tests/sandbox/run-all.ts",
    "bench": "vitest run tests/perf --reporter=verbose",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "deps:relock": "node scripts/relock-deps.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.16.0",
    "@codemirror/commands": "6.5.0",
    "@codemirror/lang-markdown": "6.2.5",
    "@codemirror/language": "6.10.1",
    "@codemirror/language-data": "6.5.1",
    "@codemirror/search": "6.5.6",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3",
    "@lezer/common": "1.2.1",
    "@lezer/highlight": "1.2.0",
    "@lezer/markdown": "1.3.0",
    "ajv": "8.12.0",
    "highlight.js": "11.9.0",
    "katex": "0.16.10",
    "mermaid": "10.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-highlight": "7.0.0",
    "rehype-katex": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.0",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.0",
    "unified": "11.0.4",
    "zod": "3.23.8",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.46.1",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.14.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "33.2.0",
    "electron-builder": "24.13.3",
    "electron-vite": "2.3.0",
    "eslint": "8.57.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "24.1.1",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "2.0.5"
  }
}
